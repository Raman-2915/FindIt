generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ItemStatus {
  ACTIVE
  MATCHED
  CLAIMED
  RETURNED
  CLOSED
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum NotificationType {
  MATCH_FOUND
  CLAIM_UPDATE
  SYSTEM
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lostItems     LostItem[]
  foundItems    FoundItem[]
  claims        Claim[]
  notifications Notification[]
  reports       Report[]       @relation("Reporter")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  lostItems  LostItem[]
  foundItems FoundItem[]
}

model LostItem {
  id          String     @id @default(uuid())
  userId      String
  categoryId  String
  title       String
  description String
  location    String
  lostAt      DateTime
  status      ItemStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  matches Match[]  @relation("LostItemMatches")
  reports Report[] @relation("ReportedLostItem")

  @@index([userId])
  @@index([categoryId])
  @@index([location])
  @@index([status])
}

model FoundItem {
  id          String     @id @default(uuid())
  userId      String
  categoryId  String
  title       String
  description String
  location    String
  foundAt     DateTime
  status      ItemStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  matches Match[]  @relation("FoundItemMatches")
  claims  Claim[]
  reports Report[] @relation("ReportedFoundItem")

  @@index([userId])
  @@index([categoryId])
  @@index([location])
  @@index([status])
  @@index([categoryId, status])
}

model Match {
  id          String      @id @default(uuid())
  lostItemId  String
  foundItemId String
  score       Float
  status      MatchStatus @default(PENDING)
  createdAt   DateTime    @default(now())

  lostItem  LostItem  @relation("LostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem FoundItem @relation("FoundItemMatches", fields: [foundItemId], references: [id], onDelete: Cascade)

  @@unique([lostItemId, foundItemId])
  @@index([lostItemId])
  @@index([foundItemId])
  @@index([score])
}

model Claim {
  id          String      @id @default(uuid())
  userId      String
  foundItemId String
  message     String
  status      ClaimStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foundItem FoundItem @relation(fields: [foundItemId], references: [id], onDelete: Cascade)

  @@unique([userId, foundItemId])
  @@index([userId])
  @@index([foundItemId])
  @@index([status])
  @@index([foundItemId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([userId, createdAt])
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  lostItemId  String?
  foundItemId String?
  reason      String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  reporter  User       @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  lostItem  LostItem?  @relation("ReportedLostItem", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem FoundItem? @relation("ReportedFoundItem", fields: [foundItemId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([lostItemId])
  @@index([foundItemId])
  @@index([status])
}
